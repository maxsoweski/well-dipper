{
  "name": "well-dipper",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync-ships": "bash scripts/sync-ships.sh",
    "generate-glow": "node scripts/generate-galaxy-glow.mjs",
    "generate-glow:test": "node scripts/generate-galaxy-glow.mjs --test",
    "gen-feature-cards": "node scripts/gen-feature-cards.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:instruments": "rc=0; echo ''; echo '=== Instrument A - per-test-ID baseline ==='; npm run --silent test:baseline || rc=1; echo ''; echo '=== Instrument B - body-identity fence ==='; npm run --silent test:body-identity || rc=1; echo ''; echo '=== Instrument C - shipped-uniform delta ==='; npm run --silent port-uniform-delta:check || rc=1; echo ''; echo '=== Instrument C - citation fence ==='; npm run --silent port-uniform-delta:citations || rc=1; echo ''; if [ $rc -ne 0 ]; then echo 'INSTRUMENTS: FAILED - at least one instrument moved. Read the section(s) above; do NOT re-record without naming what moved.'; else echo 'INSTRUMENTS: all four green (A per-test-ID, B body-identity, C shipped-uniform + citations).'; fi; exit $rc",
    "test:baseline": "node scripts/test-baseline.mjs --check",
    "test:baseline:record": "node scripts/test-baseline.mjs --record",
    "test:body-identity": "vitest run tests/body-identity-fence.test.js --exclude '**/.claude/**'",
    "test:body-identity:rebless": "WD_REBLESS_BODY_IDENTITY=1 vitest run tests/body-identity-fence.test.js --exclude '**/.claude/**'",
    "port-uniform-delta": "node tools/port-uniform-delta.mjs",
    "port-uniform-delta:check": "node tools/port-uniform-delta.mjs --check",
    "port-uniform-delta:record": "node tools/port-uniform-delta.mjs --record",
    "port-uniform-delta:selftest": "node tools/port-uniform-delta.mjs --selftest",
    "verify-golden": "node tests/golden-trajectories/run-golden.mjs",
    "rebless-golden": "node tests/golden-trajectories/run-golden.mjs --record",
    "doc-rot": "bash scripts/doc-rot-check.sh",
    "doc-graph": "node scripts/doc-graph.js",
    "uat-status": "bash scripts/uat-status.sh",
    "mood-bootstrap": "bash scripts/mood-index-bootstrap.sh",
    "port-uniform-delta:citations": "node tools/port-uniform-delta.mjs --check-citations"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "madge": "^8.0.0",
    "pngjs": "^7.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "alea": "^1.0.1",
    "lil-gui": "^0.21.0",
    "sharp": "^0.34.5",
    "simplex-noise": "^4.0.3",
    "three": "^0.183.1"
  }
}
